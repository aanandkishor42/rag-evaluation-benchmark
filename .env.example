# Only needed for the paid OpenAI cloud backend (provider: openai in config.yaml).
# The free local Ollama backend needs no API key.
OPENAI_API_KEY=sk-your-key-here

# Needed for the free public deployment (config.cloud.yaml -> provider: groq).
GROQ_API_KEY=gsk_your-groq-key            # free key from console.groq.com -> API Keys

# Needed for HuggingFace embeddings in the cloud deployment (free).
HF_TOKEN=hf_your-huggingface-token        # free token from huggingface.co -> Settings -> Access Tokens